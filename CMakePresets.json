{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "mingw",
      "displayName": "MinGW + Ninja",
      "description": "Base preset: Ninja with the Windows install prefixes of GLFW/GLM (msys64 mingw64) and KTX-Software. Needs VULKAN_SDK set.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/msys64/mingw64;C:/Program Files/KTX-Software"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug, warnings as errors",
      "inherits": "mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ALPHA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "mingw",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" }
  ]
}
