#version 450

// Recap:
// - Downsamples linear depth pyramid: mip k+1 = min/max over 2x2 of mip k.
// - Preserves min for conservative occlusion and max for thickness checks.
// - Consumes sampler mip k and writes storage image mip k+1 (bound via view).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uPyramid;

layout(rg16f, set = 0, binding = 1) uniform writeonly image2D uDstMip;

void main() {
    ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(uDstMip);
    if (dstCoord.x >= dstSize.x || dstCoord.y >= dstSize.y) {
        return;
    }

    // Mip sizes are max(1, size >> 1). An odd source size leaves one extra row/column that no 2x2 block covers,
    // so the last destination texel also takes it; a source size of 1 is clamped instead of reading out of bounds.
    ivec2 srcSize = textureSize(uPyramid, 0);
    ivec2 srcCoord = dstCoord * 2;
    int extentX = 2 + ((dstCoord.x == dstSize.x - 1 && (srcSize.x & 1) == 1) ? 1 : 0);
    int extentY = 2 + ((dstCoord.y == dstSize.y - 1 && (srcSize.y & 1) == 1) ? 1 : 0);

    float minDepth = 3.402823e38;
    float maxDepth = -3.402823e38;
    for (int y = 0; y < extentY; ++y) {
        for (int x = 0; x < extentX; ++x) {
            ivec2 coord = min(srcCoord + ivec2(x, y), srcSize - ivec2(1));
            vec2 d = texelFetch(uPyramid, coord, 0).rg;
            minDepth = min(minDepth, d.r);
            maxDepth = max(maxDepth, d.g);
        }
    }
    imageStore(uDstMip, dstCoord, vec4(minDepth, maxDepth, 0.0, 0.0));
}


